# Exemplo: o item cart-2.2 define o comando final. Instalada DESLIGADA (sem enable).
[Unit]
Description=SabreHosting - cartorio (versao do mundo e trava de host)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
User=sabre
Group=sabre
WorkingDirectory=/opt/sabre/cartorio
# Escuta só na rede privada (IP do hub WireGuard); banco e cópia do mundo em /var/lib/sabre/cartorio.
Environment=SABRE_CARTORIO_ENDERECO=10.66.0.1
Environment=SABRE_CARTORIO_DADOS=/var/lib/sabre/cartorio
ExecStart=/usr/bin/node /opt/sabre/cartorio/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sabre

[Install]
WantedBy=multi-user.target
